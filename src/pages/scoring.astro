---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PageIntro from "@/components/PageIntro.astro";
import IssueScore from "@/components/IssueScore.astro";
import { siteConfig } from "@/config/site";


const launchScores = [
  [50, "More than promised", "Delivers, plays brilliantly, and gives us more than we expected."],
  [25, "Did their fucking job", "A solid game that delivers what it sold."],
  [-25, "Rough edges", "Technical trouble, missing features, or annoying design dragging it down."],
  [-50, "Should've been better", "Serious flaws in delivery, gameplay, writing, or value."],
  [-100, "The sales pitch fell apart", "Major broken promises, widespread failures, or a deeply disappointing game."],
  [-150, "What the fuck did we pay for?", "Broken, badly misrepresented, or just miserable to play. Explain which."],
] as const;
---

<BaseLayout title="Scoring guide" description="Promises, gameplay, writing, and value. Our scores include our opinions. Here's how the points work.">
  <SiteHeader />
  <main id="content">
    <div class="reading">
      <PageIntro
        title="Deliver. And make it worth playing."
        description="A game can run perfectly and still be shit. We judge what shipped, how it plays, and whether it was worth your money."
        note="Scoring guide · Version 2.2 · September 2026"
      />
    </div>
    <div class="reading section--tight prose scoring-guide">
      <h2 id="principles">The basics</h2>
      <p>Developers start at <strong>1,000</strong>. Add each game's running score. No resets.</p>
      <p><strong>These are our judgments, not scientific measurements.</strong> Boring combat, weak writing, shit value, or a game that plays itself can lose points even without a single crash. You can disagree. That's how opinions work.</p>
      <p>Heavy-handed politics or social preaching can lose points when we think it hijacks the story or turns characters into mouthpieces. Show the actual scene and explain the problem. “We hated this” is an opinion; “they lied about this” needs receipts.</p>

      <h2 id="launch">One launch. One score.</h2>
      <p><strong>The numbers are guideposts.</strong> +23 or +12 is fine. The usual launch range is <strong>−150 to +50</strong>. Anything outside it needs a clearly labelled exception and reasons. No pretending personal taste is a benchmark.</p>
      <div class="rubric">
        {launchScores.map(([score, title, detail]) => (
          <article class="rubric-row">
            <IssueScore score={score} />
            <div><h3>{title}</h3><p>{detail}</p></div>
          </article>
        ))}
      </div>

      <h2 id="recovery">Fix your shit. Recover half.</h2>
      <p>Working fixes, delivered promises, and changes that address our criticisms can earn back <strong>at most half the launch loss, combined</strong>. Show what improved. Round the cap down to a whole point: −25 allows +12 back.</p>
      <p>Apologies and roadmaps earn <strong>zero</strong>. “It's coming later” can suck it. Shipping it late doesn't make the launch good.</p>

      <h2 id="rewards">Extra work earns extra credit.</h2>
      <p><strong>+25</strong> for substantial free additions. <strong>+50</strong> for a major free expansion. Beyond the original promises, released and working. One award per update; no double-counting.</p>
      <p>Update awards are flexible too, up to +50 each. Recovery still stops at half the launch loss. Preferences about length or difficulty alone aren't broken promises.</p>
      <p>Paid DLC earns no bonus. Extra work can take the total above its starting point. The launch penalty stays in the history.</p>

      <h2 id="examples">The maths</h2>
      <p><strong>−100</strong> launch → <strong>+50</strong> recovery → <strong>+50</strong> free expansion = <strong>0</strong> from this game. Back to even by doing more than they owed you.</p>

      <h2 id="updates">Bring receipts. Keep it short.</h2>
      <ul>
        <li>Actual public promises. Not fan theories. Clearly disclosed early-access limitations aren't broken promises.</li>
        <li>One issue per game: promise, result, score, dated updates. Link evidence and name the platform/version. Old games get the same rules.</li>
        <li>Separate facts from opinions. Unverified claims don't cost points. Factual mistakes get labelled corrections; changed opinions get explained updates.</li>
      </ul>
      <p class="t-small t-dim">Version 2.2 explicitly includes gameplay, writing, value, and editorial opinion. Existing scores aren't automatically recalculated.</p>
    </div>

    <section class="reading section--tight">
      <p class="t-body t-dim">
        Corrections or questions? <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
      </p>
    </section>

  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .scoring-guide { padding-bottom: 4rem; }
  .scoring-guide h2 { scroll-margin-top: 6rem; margin-top: 2rem; }
  .rubric-row { display: grid; grid-template-columns: 5rem minmax(0, 1fr); align-items: start; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .rubric-row h3 { margin: 0; font-size: 1.1rem; }
  .rubric-row p { margin: .35rem 0 0; }
  @media (max-width: 600px) {
    .rubric-row { grid-template-columns: 3.75rem minmax(0, 1fr); gap: .65rem; }
  }
</style>
