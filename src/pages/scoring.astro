---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PageIntro from "@/components/PageIntro.astro";
import IssueScore from "@/components/IssueScore.astro";
import { siteConfig } from "@/config/site";
import { scoring } from "@/lib/verdict/score";

/* Every number on this page comes from src/lib/verdict/score.ts, so the guide can't drift from the maths. */
const flagText: Record<keyof typeof scoring.monetization, string> = {
  pay_to_win: "Pay to win: power, progress or advantage sold for real money",
  loot_boxes: "Paid loot boxes or gacha",
  cut_content_dlc: "Content shown for the base game (or on the disc) sold separately",
  content_removed: "Content removed from a game people already bought",
  marketed_content_paywalled: "Content from the marketing that turns out to be paid extra",
  premium_with_mtx: "A real-money store in a full-price game",
  battle_pass_in_premium: "A battle pass in a full-price game",
  forced_online: "Always-online for a single-player game",
  invasive_drm: "DRM that hurts paying players (performance, install limits, kernel access)",
  preorder_exclusive_gameplay: "Gameplay content locked to pre-orders",
  currency_pack_mismatch: "Currency packs sized so you always have to buy more",
};
const stabilityText: Record<keyof typeof scoring.stability, string> = {
  solid: "Nothing notable beyond normal day-one patches.",
  minor_issues: "Some players hit crashes or bugs; most finish without serious trouble.",
  buggy: "Coverage describes the launch itself as buggy; problems hit a large share of players.",
  broken: "Save corruption, progression blockers or crashes that make normal play unreliable.",
  unplayable: "Many players can't play at all, or a version was pulled from sale.",
};
const verdictText = {
  delivered: "Shipped as shown",
  delivered_late: `Missing at launch, added free within the ${14}-day window`,
  partial: "Shipped, but smaller, worse or narrower than shown",
  cut: "Not in the game",
  misleading: "Shown or worded in a way the shipped game contradicts",
  unverified: "Couldn't be confirmed either way. Costs nothing.",
} as const;
---

<BaseLayout
  title="Scoring guide"
  description="How a game's score is calculated: promises kept, monetization, launch stability, reception and value. Facts in, number out."
>
  <SiteHeader />
  <main id="content">
    <div class="reading">
      <PageIntro
        title="Facts in. Number out."
        description="Nobody here picks a score. We record what was promised and what shipped, with sources, and a published formula turns that into points."
        note={`Scoring guide · Version ${scoring.version}`}
      />
    </div>

    <div class="reading section--tight prose scoring-guide">
      <h2 id="ledger">The ledger</h2>
      <p>
        Every game gets a <strong>ledger</strong>: the checkable promises from trailers, store pages and interviews, the monetization practices,
        the launch-window stability, aggregate reception and value. Every entry links to its source, and the ledger is printed under every review.
        Anything we can't source doesn't count against the developer.
      </p>
      <p>
        Research and first drafts are done by AI. A second AI fact-checks every claim against the ledger, and a human approves before anything goes live.
        If you find a wrong fact, send us a source; corrections that change a score are labelled.
      </p>

      <h2 id="developers">Developers and publishers</h2>
      <p>
        Every studio and every publisher starts at <strong>{scoring.developerBase.toLocaleString("en-US")} points</strong>. Each game adds its score to both.
        Monetization calls are usually the publisher's, so <strong>a penalty the publisher owns doesn't touch the developer</strong>. Self-published games
        put everything on one ledger. A bad launch stays on the record; climbing back takes good games.
      </p>

      <h2 id="promises">1 · Promises: up to +{scoring.deliveryMax}, down to {scoring.deliveryMin}</h2>
      <p>
        Each promise is weighted by how loudly it was sold: <strong>headline ×{scoring.weight.headline}</strong> (reveal trailer, store banner),
        <strong>major ×{scoring.weight.major}</strong> (repeated in marketing), <strong>minor ×{scoring.weight.minor}</strong>. Fan expectations aren't promises.
      </p>
      <ul>
        {Object.entries(verdictText).map(([key, text]) => (
          <li><strong>{key.replace("_", " ")}</strong> ({scoring.verdictValue[key as keyof typeof verdictText] >= 0 ? "+" : ""}{scoring.verdictValue[key as keyof typeof verdictText]}): {text}</li>
        ))}
      </ul>
      <p>
        The weighted average becomes the delivery score. With fewer than {scoring.deliveryFullConfidenceAt} verified promises it's scaled down, so one
        lucky or unlucky claim can't swing a game.
      </p>

      <h2 id="money">2 · Monetization: penalties only</h2>
      <p>Minor cases cost {scoring.minorShare * 100}% of the listed penalty. Cosmetics in a free-to-play game aren't flagged.</p>
      <div class="rubric">
        {Object.entries(scoring.monetization).map(([flag, points]) => (
          <article class="rubric-row">
            <IssueScore score={-points} />
            <div><p>{flagText[flag as keyof typeof flagText]}</p></div>
          </article>
        ))}
      </div>

      <h2 id="stability">3 · Launch stability: the first 14 days</h2>
      <p>
        We judge the release and its first two weeks. Minor issues verifiably fixed by day 14 cost nothing, and a buggy launch fixed in that window
        costs half. Broken stays broken: that should have been caught before release.
      </p>
      <div class="rubric">
        {Object.entries(scoring.stability).map(([level, points]) => (
          <article class="rubric-row">
            <IssueScore score={points} />
            <div><h3>{level.replace("_", " ")}</h3><p>{stabilityText[level as keyof typeof stabilityText]}</p></div>
          </article>
        ))}
      </div>

      <h2 id="reception">4 · Reception: is it actually good?</h2>
      <p>
        Whether a game is fun isn't something we get to decide alone, so we use the consensus: player scores (Steam, Metacritic users) weighted
        {Math.round(scoring.userShare * 100)}%, critic aggregates {Math.round((1 - scoring.userShare) * 100)}%. Players count more because critics get
        review codes and press events.
      </p>
      <div class="rubric">
        {scoring.reception.map(([floor, points]) => (
          <article class="rubric-row">
            <IssueScore score={points} />
            <div><p>Consensus {floor}+</p></div>
          </article>
        ))}
      </div>

      <h2 id="value">5 · Value</h2>
      <p>
        A game at ${scoring.value.fullPriceUsd}+ with a main story under {scoring.value.shortHours} hours (HowLongToBeat) loses {scoring.value.shortPenalty} points.
      </p>

      <h2 id="editorial">6 · The editor's call: ±{scoring.editorialLimit}, always explained</h2>
      <p>
        Some things the numbers miss: combat that plays itself, writing that guts a character, a sequel that's a reskin. The editor can move a score by
        at most {scoring.editorialLimit} points either way. It's shown as its own line with the reason, so you can see exactly how much is opinion.
      </p>

      <h2 id="repair">Repairs: soften the loss, never erase it</h2>
      <p>
        One substantial free patch that fixes a failed launch can win back up to <strong>half the loss</strong>. Speed matters: the full half within 30 days,
        60% of it within 90, 35% within six months, 15% within a year, nothing after. Routine patches, roadmaps, apologies and paid DLC earn nothing. The
        original launch verdict stays on the record.
      </p>

      <h2 id="range">The range</h2>
      <p>
        Scores run from <IssueScore score={scoring.range.min} /> to <IssueScore score={scoring.range.max} />. Around +20 means it delivered and was worth
        the money. Below zero, the launch let players down.
      </p>
      <p class="t-small t-dim">Version {scoring.version} replaced the hand-scored rubric with a formula. All earlier reviews were rescored with it.</p>
    </div>

    <section class="reading section--tight">
      <p class="t-body t-dim">Corrections or questions? <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .scoring-guide { padding-bottom: 4rem; }
  .scoring-guide h2 { scroll-margin-top: 6rem; margin-top: 2rem; }
  .rubric-row { display: grid; grid-template-columns: 5rem minmax(0, 1fr); align-items: start; gap: 1rem; padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .rubric-row h3 { margin: 0; font-size: 1.05rem; text-transform: capitalize; }
  .rubric-row p { margin: .2rem 0 0; }
  @media (max-width: 600px) {
    .rubric-row { grid-template-columns: 3.75rem minmax(0, 1fr); gap: .65rem; }
  }
</style>
