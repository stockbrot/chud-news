---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import GenreBrowser from "@/components/GenreBrowser.astro";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { topicMeta } from "@/config/topics";
import {
  byTopic,
  publishedIssues,
  topicSlug,
  topics,
  withTrailingSlash,
  type Issue,
  type Topic,
} from "@/lib/issues";

export const getStaticPaths = (async ({ paginate }) => {
  const issues = publishedIssues(await getCollection("issues"));

  return topics.flatMap((topic) =>
    paginate(byTopic(issues, topic), {
      pageSize: 12,
      params: { topic: topicSlug(topic) },
      props: { topic },
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  topic: Topic;
  page: Page<Issue>;
}

const { topic, page } = Astro.props;
const issues = publishedIssues(await getCollection("issues"));

const title = page.currentPage === 1 ? topic : `${topic} - Page ${page.currentPage}`;
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<BaseLayout
  title={title}
  description={topicMeta[topic].summary}
  image={page.data[0]?.data.cover.src}
  imageAlt={page.data[0]?.data.cover.alt}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <SiteHeader />
  <main id="content">
    <div class="container">
      <PageIntro
        title={topic}
        description={topicMeta[topic].summary}
        note={`${page.total} ${page.total === 1 ? "issue" : "issues"}`}
      />
    </div>

    <section class="container section--tight" aria-label={`${topic} issues`}>
      <GenreBrowser issues={issues} initialTopic={topic} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
