---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/config/site";
import { websiteSchema } from "@/lib/schema";
import "@/styles/global.css";
import EmoteRuntime from "@/components/EmoteRuntime.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * The share card. An imported image is cropped to card proportions at build
   * time; a string path is used as-is, for files already in `public/`.
   */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = "website",
  noindex = false,
  prevUrl,
  nextUrl,
  structuredData,
} = Astro.props;

/* Every scraper crops to 1200x630, so the card is cut here rather than shipping
   a 2000px cover and letting each of them take a different slice. Both
   dimensions are clamped to the source, because Astro will not enlarge an image
   and the width below would then be a number no scraper could verify. */
const cardRatio = 1200 / 630;
const cardSource = image && typeof image !== "string" ? image : undefined;
const cardWidth = Math.min(1200, cardSource?.width ?? 1200);
const cardHeight = Math.min(Math.round(cardWidth / cardRatio), cardSource?.height ?? 630);
const card = cardSource
  ? await getImage({
      src: cardSource,
      width: cardWidth,
      height: cardHeight,
      fit: "cover",
      position: "center",
      format: "jpeg",
      quality: 82,
    })
  : undefined;

const socialImage = card?.src ?? (typeof image === "string" ? image : siteConfig.socialImage);
const socialImageAlt = imageAlt ?? `${siteConfig.name} — ${siteConfig.tagline}`;
const absoluteImage = new URL(socialImage, siteConfig.siteUrl).toString();
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;

/* "system" cannot be known at build time, so the document starts on the
   configured default and the blocking script corrects it before paint. */
const defaultColorMode = siteConfig.defaultColorMode;
const initialTheme = defaultColorMode === "dark" ? "dark" : "light";
const schema = structuredData ?? websiteSchema();
---

<!doctype html>
<html lang={siteConfig.language} data-theme={initialTheme} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <link
      rel="preload"
      href="/fonts/figtree/Figtree-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={new URL("/rss.xml", siteConfig.siteUrl).toString()}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      card && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(cardWidth)} />
          <meta property="og:image:height" content={String(cardHeight)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline define:vars={{ defaultColorMode }}>
      (() => {
        const storageKey = "mailer-theme";
        const query = window.matchMedia("(prefers-color-scheme: dark)");

        const getStored = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };

        const preferredTheme = () => {
          const stored = getStored();
          return stored === "light" || stored === "dark"
            ? stored
            : defaultColorMode === "system"
              ? query.matches
                ? "dark"
                : "light"
              : defaultColorMode;
        };

        const setTheme = (theme, persist = false, root = document.documentElement) => {
          root.dataset.theme = theme;
          if (!persist) return;
          try {
            localStorage.setItem(storageKey, theme);
          } catch {}
        };

        setTheme(preferredTheme());

        /* Put the saved theme on the incoming document before Astro swaps it
           into view. This prevents a dark page from flashing light. */
        if (!window.mailerThemeReady) {
          window.mailerThemeReady = true;
          document.addEventListener("astro:before-swap", (event) => {
            setTheme(preferredTheme(), false, event.newDocument.documentElement);
          });

          query.addEventListener("change", (event) => {
            if (defaultColorMode !== "system") return;
            const stored = getStored();
            if (stored === "light" || stored === "dark") return;
            setTheme(event.matches ? "dark" : "light");
          });

          document.addEventListener("astro:page-load", () => {
            setTheme(preferredTheme());
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
              if (button.dataset.themeReady) return;
              button.dataset.themeReady = "true";
            button.addEventListener("click", () => {
                setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });
        });
        }
      })();
    </script>
  </head>
  <body>
    <!-- <a class="skip-link" href="#content">Skip to content</a> -->
    <slot />
    <EmoteRuntime />
  </body>
</html>
