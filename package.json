{
  "name": "chud-news",
  "description": "Holds game developers and publishers accountable: what they promised vs what they shipped.",
  "type": "module",
  "version": "1.0.0",
  "author": "Andrei Alba",
  "license": "MIT",
  "keywords": [
    "games",
    "reviews",
    "accountability",
    "astro",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply chud-news --local",
    "db:migrate:remote": "wrangler d1 migrations apply chud-news --remote",
    "publish:approved": "tsx scripts/publish-approved.ts",
    "ledger:score": "tsx scripts/score-ledger.ts",
    "ledger:apply": "tsx scripts/apply-ledger.ts",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^22.16.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "yaml": "$yaml"
  }
}
